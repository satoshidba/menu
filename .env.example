# ---- Required ------------------------------------------------------------------------------------------------
# Database password (any long random string). Generate one with: openssl rand -base64 24
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# The address you open on your phone/tablet. Use a name your router/DNS points at this machine,
# e.g. larder.home.arpa (home network) or larder.example.com (public). Add a port if 443 is taken: larder.home.arpa:8443
LARDER_SITE_ADDRESS=larder.home.arpa
LARDER_PUBLIC_URL=https://larder.home.arpa

# "internal" = Caddy's private certificate authority for home networks (install its root certificate once on each
# device; see docs/SETUP.md). For a public domain with ports 80/443 forwarded, put your email address here instead.
LARDER_TLS=internal

# ---- Optional: AI provider (server-side only; never sent to the browser) ---------------------------------------
# Leave the key empty to run without AI: manual entry, URL import from structured pages, OCR and everything else work.
LARDER_AI_PROVIDER=anthropic
LARDER_ANTHROPIC_API_KEY=
LARDER_AI_MODEL=claude-opus-5-5
LARDER_AI_EFFORT=medium

# ---- Optional: barcode lookups (Open Food Facts) ---------------------------------------------------------------
LARDER_OFF_ENABLED=true
LARDER_OFF_USER_AGENT=Larder/1.0 (self-hosted household app)

# ---- Backups -------------------------------------------------------------------------------------------------
LARDER_BACKUP_ENABLED=true
# Hour (UTC) for the nightly backup, and how many archives to keep
LARDER_BACKUP_HOUR_UTC=3
LARDER_BACKUP_KEEP=14
# Set a passphrase to encrypt backups (AES-256-GCM). Keep it somewhere safe: without it a backup can't be restored.
LARDER_BACKUP_PASSPHRASE=
# Where backup archives are written on the host. Copy them off this machine regularly.
LARDER_BACKUP_DIR=./backups

# ---- Advanced ------------------------------------------------------------------------------------------------
LARDER_TIMEZONE=Europe/London
LARDER_MAX_UPLOAD_MB=15
LARDER_IMPORT_RATE_PER_MINUTE=20
LARDER_LOGIN_RATE_PER_MINUTE=10
LARDER_WEB_WORKERS=2
# LARDER_HTTP_PORT=80
# LARDER_HTTPS_PORT=443
