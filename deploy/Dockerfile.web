# syntax=docker/dockerfile:1
FROM node:22.23.4-alpine AS build
# Optional extra CA certificates (certs/*.crt); see certs/README
COPY certs/ /usr/local/share/ca-certificates/extra/
RUN cat /usr/local/share/ca-certificates/extra/*.crt > /tmp/extra-ca.pem 2>/dev/null || true
ENV NODE_EXTRA_CA_CERTS=/tmp/extra-ca.pem
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM caddy:2.8.4-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /src/dist /srv
# Font licences travel with the self-hosted font files
COPY --from=build /src/node_modules/@fontsource-variable/newsreader/LICENSE /srv/licences/Newsreader-OFL.txt
COPY --from=build /src/node_modules/@fontsource/ibm-plex-sans/LICENSE /srv/licences/IBM-Plex-Sans-OFL.txt
